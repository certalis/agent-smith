{
	"name": "@agent-smith/server",
	"version": "0.1.0",
	"type": "module",
	"main": "./src/server.ts",
	"scripts": {
		"dev": "bun run --hot src/server.ts",
		"start": "bun run src/server.ts",
		"build": "bun build src/server.ts --compile --outfile dist/agent-smith-server",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@agent-smith/core": "workspace:*",
		"@agent-smith/database": "workspace:*",
		"@agent-smith/config": "workspace:*",
		"@agent-smith/runtime-server": "workspace:*",
		"@agent-smith/logger": "workspace:*",
		"@agent-smith/proxy": "workspace:*",
		"@agent-smith/providers": "workspace:*",
		"@agent-smith/types": "workspace:*",
		"@agent-smith/api": "workspace:*",
		"@agent-smith/http": "workspace:*"
	}
}
